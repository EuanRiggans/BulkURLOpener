{
  "name": "bulkurlopener",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A browser extension for opening URLs in batches and managing saved lists",
  "scripts": {
    "dev": "wxt -b chrome --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "prepare:types": "wxt prepare",
    "postinstall": "wxt prepare",
    "build": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:all": "npm run build && npm run build:firefox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:packaging": "node --test --test-isolation=none test/packaging/*.test.mjs",
    "test:browser": "node --test --test-isolation=none test/browser/*.test.mjs",
    "test": "npm run test:unit && npm run test:packaging",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "check:build": "node scripts/verify-builds.mjs",
    "check:source": "node scripts/verify-source.mjs",
    "licenses:update": "node scripts/licenses.mjs --write",
    "package": "npm run build:all && npm run package:built",
    "package:built": "node scripts/package.mjs",
    "check:packages": "node scripts/verify-packages.mjs",
    "check:reproducibility": "node scripts/check-reproducibility.mjs",
    "lint:firefox": "node scripts/lint-firefox.mjs",
    "validate": "npm run check:source && npm run check && npm run build:all && npm run check:build && npm run lint:firefox"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EuanRiggans/BulkURLOpener.git"
  },
  "author": "Euan Riggans",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jridgewell/trace-mapping": "0.3.31",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "fflate": "0.8.3",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "selenium-webdriver": "4.51.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  },
  "dependencies": {
    "preact": "11.1.1",
    "valibot": "1.5.0"
  }
}
